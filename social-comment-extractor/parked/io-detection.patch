+/* สร้าง audit ตัวอย่างให้จำนวนตรงกับ sentiment ที่โชว์ (เฉพาะโหมด demo) */
+function buildDemoAudit(counts){
+  const T = {
+    positive: ["รสชาติดีมาก คุ้มราคา จะกลับมาอุดหนุนอีกแน่นอน","บริการประทับใจ พนักงานน่ารัก แนะนำเลย","ชื่นชมทีมงานที่ลงพื้นที่ช่วยจริงจัง"],
+    neutral:  ["รสชาติโอเค ตามราคา ไม่ได้หวือหวาอะไร","บริษัทออกแถลงการณ์ชี้แจงแล้วนะครับ","เรื่องนี้เกี่ยวข้องกันยังไงเหรอครับ"],
+    negative: ["ส่งช้ามาก รอเกินเวลาที่แจ้งไว้ ผิดหวังนิดหน่อย","แพงไปนิดเมื่อเทียบกับปริมาณ ครั้งหน้าคงคิดหนัก","ต้องออกมารับผิดชอบกับสิ่งที่เกิดขึ้น"],
+    not_related: ["ปลาหมอคางดำระบาดหนักมากในพื้นที่","รัฐควรเร่งแก้ปัญหานี้โดยด่วน","สงสารชาวประมงที่ได้รับผลกระทบ"],
+  };
+  const rows = [];
+  for (const [k, n] of Object.entries(counts)) {
+    for (let i = 0; i < (n||0); i++) rows.push({ text: T[k][i % T[k].length], sentiment: k });
+  }
+  // ติดธง IO ให้ 3 ใบแรกที่พอมี เพื่อให้เห็นฟีเจอร์
+  const whys = ["ข้อความซ้ำกับอีก 4 คอมเมนต์","ข้อความซ้ำกับอีก 4 คอมเมนต์","คนเดียวคอมเมนต์ 5 ครั้ง"];
+  let count = 0;
+  for (let i = 0; i < rows.length && count < 3; i += Math.max(1, Math.floor(rows.length/3))) {
+    rows[i].io = true; rows[i].io_why = whys[count++];
+  }
+  return { rows, count };
+}
