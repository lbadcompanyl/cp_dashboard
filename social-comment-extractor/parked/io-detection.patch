+/* ---------------- IO (คอมเมนต์จัดตั้ง) ----------------
+   ตัดออกแล้วคำนวณใหม่ในเครื่องเลย — ไม่เรียก API ซ้ำ ไม่เสียเครดิต/โทเคน
+   ⚠️ สรุป/keyword มาจาก AI ตอนวิเคราะห์ครั้งแรก (ยังคิดจากชุดเต็ม) จึงบอกไว้บนจอ */
+let excludeIO = false;
+function ioFiltered(d){
+  if (!d) return d;
+  const audit = d.audit || [];
+  if (!excludeIO || !audit.some(a => a.io)) return d;
+  const kept = audit.filter(a => !a.io);
+  const sentiment = { positive:0, neutral:0, negative:0 };
+  let not_related = 0;
+  kept.forEach(a => { if (a.sentiment === "not_related") not_related++; else if (sentiment[a.sentiment] != null) sentiment[a.sentiment]++; });
+  return { ...d, sentiment, not_related, audit: kept, analyzed_count: kept.length, io_excluded: true };
+}
+el("ioExclude").onchange = e => {
+  excludeIO = e.target.checked;
+  if (lastResult) renderResult(ioFiltered(lastResult));
+};
